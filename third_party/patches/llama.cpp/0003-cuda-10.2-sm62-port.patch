diff --git a/ggml/src/ggml-cuda/vendors/cuda_bf16_compat.h b/ggml/src/ggml-cuda/vendors/cuda_bf16_compat.h
new file mode 100644
index 0000000..4995af5
--- /dev/null
+++ b/ggml/src/ggml-cuda/vendors/cuda_bf16_compat.h
@@ -0,0 +1,83 @@
+#pragma once
+
+// lumen: CUDA < 11 has no cuda_bf16.h. This header provides the subset of its API
+// that ggml-cuda uses, emulated in software. Storage matches CUDA 11's
+// __nv_bfloat16 (the upper 16 bits of an IEEE-754 float), so tensors stay
+// binary-compatible. GPUs below sm_80 have no bf16 arithmetic units anyway: CUDA 11
+// emulates bf16 math through float on them as well.
+
+#include <cuda_runtime.h>
+#include <cstring>
+
+static __host__ __device__ __forceinline__ unsigned int ggml_bf16_compat_f2u(float f) {
+#ifdef __CUDA_ARCH__
+    return __float_as_uint(f);
+#else
+    unsigned int u;
+    memcpy(&u, &f, sizeof(u));
+    return u;
+#endif
+}
+
+static __host__ __device__ __forceinline__ float ggml_bf16_compat_u2f(unsigned int u) {
+#ifdef __CUDA_ARCH__
+    return __uint_as_float(u);
+#else
+    float f;
+    memcpy(&f, &u, sizeof(f));
+    return f;
+#endif
+}
