+static __host__ __device__ __forceinline__ float __bfloat162float(__nv_bfloat16 h) { return float(h); }
+
+static __host__ __device__ __forceinline__ __nv_bfloat162 __floats2bfloat162_rn(float a, float b) {
+    return __nv_bfloat162(__nv_bfloat16(a), __nv_bfloat16(b));
+}
+static __host__ __device__ __forceinline__ __nv_bfloat162 __float22bfloat162_rn(float2 f) {
+    return __floats2bfloat162_rn(f.x, f.y);
+}
+static __host__ __device__ __forceinline__ __nv_bfloat162 __bfloat162bfloat162(__nv_bfloat16 h) {
+    return __nv_bfloat162(h, h);
+}
+static __host__ __device__ __forceinline__ __nv_bfloat162 make_bfloat162(__nv_bfloat16 a, __nv_bfloat16 b) {
+    return __nv_bfloat162(a, b);
+}
+static __host__ __device__ __forceinline__ float2 __bfloat1622float2(__nv_bfloat162 h) {
+    return make_float2(float(h.x), float(h.y));
+}
+static __host__ __device__ __forceinline__ __nv_bfloat16 __low2bfloat16(__nv_bfloat162 h)  { return h.x; }
+static __host__ __device__ __forceinline__ __nv_bfloat16 __high2bfloat16(__nv_bfloat162 h) { return h.y; }
+static __host__ __device__ __forceinline__ float __low2float(__nv_bfloat162 h)  { return float(h.x); }
+static __host__ __device__ __forceinline__ float __high2float(__nv_bfloat162 h) { return float(h.y); }
