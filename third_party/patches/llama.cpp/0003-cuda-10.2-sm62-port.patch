+    unsigned short x;
+
+    __nv_bfloat16() = default;
+    __host__ __device__ __nv_bfloat16(float f) : x(ggml_bf16_compat_from_float(f)) {}
+    __host__ __device__ operator float() const { return ggml_bf16_compat_u2f((unsigned int) x << 16); }
+};
+
+struct __align__(4) __nv_bfloat162 {
+    __nv_bfloat16 x;
+    __nv_bfloat16 y;
+
+    __nv_bfloat162() = default;
+    __host__ __device__ __nv_bfloat162(__nv_bfloat16 a, __nv_bfloat16 b) : x(a), y(b) {}
+};
