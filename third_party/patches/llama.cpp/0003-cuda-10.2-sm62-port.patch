+// Round to nearest even; NaNs stay NaN (quiet bit set).
+static __host__ __device__ __forceinline__ unsigned short ggml_bf16_compat_from_float(float f) {
+    unsigned int u = ggml_bf16_compat_f2u(f);
+    if ((u & 0x7fffffffu) > 0x7f800000u) {
+        return (unsigned short) ((u >> 16) | 0x40u);
+    }
+    u += 0x7fffu + ((u >> 16) & 1u);
+    return (unsigned short) (u >> 16);
+}
