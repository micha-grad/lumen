+    // lumen: optional runtime cap on the batch size that uses MMQ for dense matmuls.
+    // Larger batches go to cuBLAS (dequantize + GEMM). On GPUs without tensor cores
+    // (e.g. sm_62) MMQ has no fixed cost but scales poorly with the batch size, while
+    // cuBLAS has a fixed dequantization cost per matmul and scales well, so the best
+    // choice depends on the batch size. Unset: upstream behaviour.
+    static const int64_t mmq_max_batch = []() {
+        const char * env = getenv("GGML_CUDA_MMQ_MAX_BATCH");
+        return env != nullptr ? (int64_t) atoll(env) : (int64_t) -1;
+    }();
+    if (mmq_max_batch >= 0 && n_experts == 0 && ne11 > mmq_max_batch) {
+        return false;
+    }
